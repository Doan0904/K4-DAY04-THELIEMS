{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Original team eval cases. Includes dedicated cases for bonus tools lookup_ticket_status and update_ticket, plus core boundary cases (5 single-turn + 5 multi-turn).",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_lookup_ticket_status",
      "phase": "B",
      "suite": "group",
      "query": "Tiến độ xử lý sự cố INC-1042 của tôi tới đâu rồi?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup_ticket_status",
            "args": {
              "ticket_id": "INC-1042"
            }
          }
        ]
      },
      "metadata": {
        "skill": "bonus_lookup_ticket",
        "difficulty": "medium",
        "what_it_tests": "Tra cứu tiến độ ticket đã có phải dùng lookup_ticket_status."
      }
    },
    {
      "id": "G02_lookup_ticket_missing_id",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra tiến độ ticket sự cố mạng hôm qua của mình với.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_missing_ticket_id",
        "difficulty": "medium",
        "what_it_tests": "Hỏi trạng thái ticket nhưng thiếu ticket_id phải gọi clarify, không tự đoán."
      }
    },
    {
      "id": "G03_confirmed_update_ticket",
      "phase": "B",
      "suite": "group",
      "query": "Tôi xác nhận cập nhật ticket INC-1042: chuyển priority từ high thành critical.",
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "update_ticket",
            "args": {
              "ticket_id": "INC-1042",
              "priority": "critical",
              "confirmed": true
            }
          }
        ]
      },
      "metadata": {
        "skill": "bonus_update_ticket_confirmed",
        "difficulty": "hard",
        "what_it_tests": "Có xác nhận rõ ràng thì update_ticket được phép chạy với confirmed=true."
      }
    },
    {
      "id": "G04_device_hardware_check",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra phần cứng của máy để bàn DT-031.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "DT-031",
              "check": "hardware"
            }
          }
        ]
      },
      "metadata": {
        "skill": "device_hardware_arg",
        "difficulty": "easy",
        "what_it_tests": "Trích đúng asset_id DT-031 và check=hardware."
      }
    },
    {
